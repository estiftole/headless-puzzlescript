=======
LEGEND
=======

. = Background

~ = Exit
V = Water
_ = Pedestal
U = Hole
O = CoveredHole
! = Spikes

# = Wall
L = Ledge
$ = Rock

P = Player

* = Crate
& = StoneCrate
0 = Ball

A = RedGate
1 = RedBarrier
B = BlueGate
2 = BlueBarrier
C = YellowGate
3 = YellowBarrier

Z = PinkPortal
9 = PinkTarget
Y = BluePortal
8 = BlueTarget
X = RedPortal
7 = RedTarget
W = GreenPortal
6 = GreenTarget

@ = PressurePlateUp
\ = GreenBarrierDown
/ = GreenBarrierUp

` = Mutex


WaterLike = Water or DarkWater
HoleLike = Hole or CoveredHole
PressurePlate = PressurePlateUp or PressurePlateDown
Target = PinkTarget or BlueTarget or RedTarget or GreenTarget
Ground = Exit or WaterLike or HoleLike or FilledHole or Pedestal or PressurePlate or GreenBarrierDown or Spikes or Target

Gate = RedGate or BlueGate or YellowGate
Barrier = RedBarrier or BlueBarrier or YellowBarrier
Portal = PinkPortal or BluePortal or RedPortal or GreenPortal

PortalLike = Ledge or Portal

GreenBarrier = GreenBarrierUp or GreenBarrierDown

PlayerLike = Player
WallLike = Wall or InactiveGate or Rock or Barrier or GreenBarrierUp


StaticObject = WallLike or Gate or PortalLike
LightObject = Crate or StoneCrate
HeavyObject = PlayerLike or Ball 

Object = StaticObject or LightObject or HeavyObject

Hardness1 = Player or Crate
Hardness2 = StoneCrate
Hardness3 = Ball

Hardness1Ghost = PlayerGhost or CrateGhost
Hardness2Ghost = Hardness1Ghost or StoneCrateGhost
Hardness3Ghost = Hardness2Ghost or BallGhost

Ghost = Hardness3Ghost

